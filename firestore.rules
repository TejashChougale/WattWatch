rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profile documents: strictly restricted to authenticated owner
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Default deny for all other document paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
